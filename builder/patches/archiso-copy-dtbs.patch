Copy /boot/dtbs into ISO 9660 so GRUB can load a device tree explicitly.
Applies after archiso-copy-boot-efi.patch (its UKI loop is the context).

--- a/archiso/mkarchiso
+++ b/archiso/mkarchiso
@@ -442,6 +442,12 @@
         install -m 0644 -- "${_uki}" "${isofs_dir}/${install_dir}/boot/${arch}/"
     done
 
+    # Device trees staged into /boot/dtbs travel with the kernel so a GRUB
+    # menu entry can pick one explicitly with the devicetree command.
+    if [[ -d "${pacstrap_dir}/boot/dtbs" ]]; then
+        cp -r -- "${pacstrap_dir}/boot/dtbs" "${isofs_dir}/${install_dir}/boot/${arch}/"
+    fi
+
     if (( need_external_ucodes )); then
         for ucode_image in "${ucodes[@]}"; do
             if [[ -e "${pacstrap_dir}/boot/${ucode_image}" ]]; then
